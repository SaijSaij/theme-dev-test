<p class="settings">{{ settings.general.tagline }}|{{ settings.general.density.value }}|{{ settings.layout.wide ? 'wide' : 'narrow' }}|{% for link in settings.general.links %}{{ link.label }}{% if not loop.last %},{% endif %}{% endfor %}|{{ wp_attachment_image(settings.general.logo, 'thumbnail') }}|{{ settings.general.footer }}|{{ settings.general.notice|raw }}|{{ wp_post_title(settings.general.privacyPage) }}|{% if settings.general.imprint.url %}<a class="settings__imprint" {{ link_attributes(settings.general.imprint) }}>Imprint</a>{% endif %}|{{ settings.general.address|nl2br }}</p>
