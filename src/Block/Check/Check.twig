<div {{ block_wrapper_attributes({class: 'check check--' ~ attrs.variant.value}) }}>
    <p class="check__text"{{ field('text') }}>{{ attrs.text }}</p>
    <div class="check__rich"{{ field('rich') }}>{{ attrs.rich|raw }}</div>
    <p class="check__count">{{ attrs.count }}</p>
    <a class="check__link" href="{{ attrs.link }}">Link</a>
    <figure class="check__image"{{ field('imageId') }}>{{ attachment_image(attrs.imageId, 'thumbnail') }}</figure>
    <p class="check__values">{{ attrs.flag ? 'on' : 'off' }} {{ attrs.ratio }} {{ attrs.note ?? 'none' }} {{ attrs.secret }}</p>
    <figure class="check__meta">
        <figcaption{{ field('meta.caption') }}>{{ attrs.meta.caption }}</figcaption>
        <a class="check__source" href="{{ attrs.meta.source }}">Source</a>
    </figure>
    <p class="check__name">{{ block_name }}</p>
    <div class="check__inner"{{ inner_blocks() }}>{{ content|raw }}</div>
</div>
