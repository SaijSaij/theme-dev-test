# Development files: needed to build the theme, not shipped in the release ZIP
# (wp-app-framework release removes every path marked export-ignore).
# Directories are matched as dir/** so the attribute applies to the files inside.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github/** export-ignore
/.php-cs-fixer.dist.php export-ignore
/CLAUDE.md export-ignore
/eslint.config.cjs export-ignore
/phpstan.dist.neon export-ignore
/README.md export-ignore
/tests/** export-ignore
/webpack.config.js export-ignore
