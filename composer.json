{
    "name": "saij/theme-dev-test",
    "description": "Test theme for wp-app-framework: its build and browser tests run against this theme.",
    "type": "wordpress-theme",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../wp-app-framework",
            "options": {
                "symlink": true,
                "relative": true
            }
        }
    ],
    "require": {
        "php": ">=8.5",
        "saij/wp-app-framework": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Saij\\ThemeDevTest\\": "src/"
        }
    },
    "scripts": {
        "build-manifest": "wp-app-framework build",
        "lint": [
            "phpstan analyse --no-progress --memory-limit=1G",
            "php-cs-fixer check --diff"
        ],
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0"
    }
}
